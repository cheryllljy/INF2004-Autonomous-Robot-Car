+LOCAL void print_barcode_widths(const char *label,
+                               const uint32_t widths[B3_BARCODE_RUNS],
+                               bool ticks)
+{
+	for (unsigned c = 0U; c < 3U; ++c) {
+		char line[120];
+		unsigned n = 0U;
+		for (unsigned k = c * 10U;
+		     (k < (c + 1U) * 10U) && (k < B3_BARCODE_RUNS); ++k) {
+			unsigned value = ticks ? (unsigned)widths[k] :
+				(unsigned)(((uint64_t)widths[k] + 50U) / 100U);
+			char digits[12];
+			unsigned d = 0U;
+			if (!ticks) {
+				digits[d++] = (char)('0' + value % 10U);
+				digits[d++] = '.';
+				value /= 10U;
+			}
+			do { digits[d++] = (char)('0' + value % 10U); value /= 10U; } while (value > 0U);
+			if (n + d + 2U >= sizeof line) break;
+			line[n++] = ' ';
+			line[n++] = (k & 1U) ? 'w' : 'B';
+			while (d > 0U) line[n++] = digits[--d];
+		}
+		line[n] = '\0';
+		tm_printf((UB*)"[VC]   %s %u-%u:%s\n", label, c * 10U,
+			  (c * 10U + 9U < B3_BARCODE_RUNS) ? c * 10U + 9U :
+				  B3_BARCODE_RUNS - 1U, line);
+	}
