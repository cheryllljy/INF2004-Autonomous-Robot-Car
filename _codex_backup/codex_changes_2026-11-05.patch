+static uint32_t g_reject_ticks;
+
+static bool reject_position_reader(uint32_t *p_ticks)
+{
+    *p_ticks = g_reject_ticks;
+    return true;
+}
+
+/* Exercise the same rejection snapshot consumed by the normal MQTT VC. */
+static void test_reject_snapshot(void)
+{
+    size_t mode;
+    for (mode = 0U; mode < 2U; ++mode)
+    {
+        b3_context_t context = {0};
+        b3_snapshot_t snapshot;
+        uint32_t times[B3_BARCODE_RUNS];
+        uint32_t ticks[B3_BARCODE_RUNS];
+        uint32_t before;
+        size_t out = 0U;
+        size_t c;
+        size_t i;
+        const char frame[3] = {'*', 'A', '*'};
+        for (c = 0U; c < 3U; ++c)
+        {
+            uint16_t pattern;
+            CHECK(b3_code39_pattern(frame[c], &pattern));
+            for (i = 0U; i < 9U; ++i)
+            {
+                bool wide = (pattern & (1U << (8U - i))) != 0U;
+                times[out] = wide ? 30000U : 10000U;
+                ticks[out++] = wide ? 30U : 10U;
+            }
+            if (c < 2U)
+            {
+                times[out] = 10000U;
+                ticks[out++] = 10U;
+            }
+        }
+        for (i = 10U; i < 19U; ++i)
+        {
+            if (mode == 0U) times[i] = 10000U;
+            else ticks[i] = 10U;
+        }
+        /* White sensor inputs before resetting the queue/decoder. */
+        g_pins = 0U;
+        g_reject_ticks = 0U;
+        CHECK(E_OK == b3_ir_init((mode == 0U) ? NULL : reject_position_reader));
+        b3_ir_enable_barcode_irq(true);
+        context.time_us = g_now;
+        buddy3_set_context(&context);
+        one_task_pass();
+        buddy3_get_snapshot(&snapshot);
+        before = snapshot.rejected_scans;
+        g_now += 200000U;
+        g_reject_ticks = 1000U;
+        emit(true);
+        context.scan_enabled = true;
+        context.motion_valid = true;
+        context.left_measured_mm_s = B3_BASE_SPEED_MM_S;
+        context.right_measured_mm_s = B3_BASE_SPEED_MM_S;
+        context.time_us = g_now;
+        buddy3_set_context(&context);
+        one_task_pass();
+        for (i = 0U; i < B3_BARCODE_RUNS; ++i)
+        {
+            g_now += times[i] - 1000U; /* emit adds the last 1000 us */
+            g_reject_ticks += ticks[i];
+            emit((i & 1U) != 0U);
+            context.time_us = g_now;
+            buddy3_set_context(&context);
+            one_task_pass();
+        }
+        buddy3_get_snapshot(&snapshot);
+        CHECK(before + 1U == snapshot.rejected_scans);
+        CHECK(B3_REJECT_DECODE == snapshot.reject_reason);
+        CHECK(B3_BARCODE_RUNS == snapshot.reject_edges);
+        CHECK(snapshot.reject_used_encoder == (mode == 1U));
+        CHECK(snapshot.reject_trimmed == (B3_TRIM_OUTER_BARS != 0));
+        for (i = 0U; i < B3_BARCODE_RUNS; ++i)
+        {
+            CHECK(((mode == 0U) ? times[i] : ticks[i]) == snapshot.reject_widths[i]);
+            CHECK(times[i] == snapshot.reject_time_widths[i]);
+        }
+    }
+    (void)puts("PASS: rejected measurement units and widths reach the MQTT-facing snapshot");
+}
+
 int main(void)
 {
     test_driver();
     test_task_boundary();
+    test_reject_snapshot();
     (void)printf("All %u adapter checks passed using test doubles.\n", g_checks);
     return EXIT_SUCCESS;
 }
