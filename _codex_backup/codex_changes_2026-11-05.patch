+/* A valid timing capture can accompany corrupt encoder widths. Diagnostics
+ * must preserve the failed input, its units, and the final outer-bar retry. */
+static void test_reject_measurements(void)
+{
+    uint32_t times[B3_BARCODE_RUNS];
+    uint32_t ticks[B3_BARCODE_RUNS];
+    uint32_t expected[B3_BARCODE_RUNS];
+    b3_barcode_t scan;
+    b3_code39_result_t decoded;
+    b3_edge_t edge;
+    size_t mode;
+    size_t i;
+
+    for (mode = 0U; mode < 3U; ++mode)
+    {
+        uint32_t *selected;
+        uint32_t narrow;
+        make_frame('A', 10000U, 30000U, times);
+        make_frame('A', (mode == 2U) ? 1U : 10U,
+                   (mode == 2U) ? 3U : 30U, ticks);
+        selected = (mode == 1U) ? ticks : times;
+        narrow = (mode == 1U) ? 10U : 10000U;
+        for (i = 10U; i < 19U; ++i)
+        {
+            selected[i] = narrow; /* not a Code 39 data character */
+        }
+        selected[0] = narrow * 4U;
+        selected[28] = narrow * 4U;
+        if (mode == 1U)
+        {
+            CHECK(b3_code39_decode(times, &decoded));
+        }
+        (void)memcpy(expected, selected, sizeof(expected));
+#if B3_TRIM_OUTER_BARS
+        expected[0] = expected[8];
+        expected[28] = expected[20];
+#endif
+        edge = feed_frame(&scan, 500000U, times,
+                          (mode == 0U) ? NULL : ticks, 200000U);
+        CHECK(B3_REJECT_DECODE == scan.reject_reason);
+        CHECK(1U == scan.rejected);
+        CHECK(B3_BARCODE_RUNS == scan.reject_count);
+        CHECK(scan.reject_used_encoder == (mode == 1U));
+        CHECK(scan.reject_trimmed == (B3_TRIM_OUTER_BARS != 0));
+        CHECK(!b3_code39_decode(scan.reject_widths, &decoded));
+        for (i = 0U; i < B3_BARCODE_RUNS; ++i)
+        {
+            CHECK(expected[i] == scan.reject_widths[i]);
+            CHECK(times[i] == scan.reject_time_widths[i]);
+        }
+        b3_barcode_abort(&scan, edge);
+        CHECK(expected[0] == scan.reject_widths[0]);
+        CHECK(scan.reject_used_encoder == (mode == 1U));
+    }
+    (void)puts("PASS: rejected encoder/time inputs, retry widths and original timing are preserved");
+}
